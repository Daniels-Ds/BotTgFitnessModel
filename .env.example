BOT_TOKEN=
# Таймаут HTTP к Telegram API (сек), в т.ч. загрузка 2 видео после генерации
TELEGRAM_REQUEST_TIMEOUT_SEC=600

# fal.ai — обязательно для видео и кадров «после»
FAL_KEY=
# Опрос статуса очереди fal (сек). По умолчанию 10 — не чаще раз в 10 с.
FAL_POLL_INTERVAL_SEC=10
FAL_FLUX_MODEL=fal-ai/wan/v2.7/edit
FAL_FLUX_ASPECT_RATIO=9:16
FAL_FLUX_SEED=3558685
# FAL_FLUX_SEED=  — пусто: без seed, каждый раз по-разному
# WAN «после»: сиды по среднему уровню зон (10/30/50)
FAL_WAN_AFTER_SEED_10=
FAL_WAN_AFTER_SEED_30=
FAL_WAN_AFTER_SEED_50=
FAL_FLUX_GUIDANCE_SCALE=3.5
FAL_FLUX_ENABLE_PROMPT_EXPANSION=false
FAL_FLUX_OUTPUT_FORMAT=jpeg
FAL_FLUX_SAFETY_TOLERANCE=5
FAL_FLUX_ENABLE_SAFETY_CHECKER=false
FAL_HAILUO_RESOLUTION=768P
FAL_HAILUO_DURATION=6
FAL_HAILUO_PROMPT_OPTIMIZER=false
# Скачивание MP4/картинок с CDN (если ConnectTimeout на прокси)
FAL_DOWNLOAD_RETRIES=4
FAL_DOWNLOAD_CONNECT_SEC=60
FAL_DOWNLOAD_READ_SEC=600
FAL_DOWNLOAD_TRY_DIRECT=true
# FAL_HAILUO_MODEL=fal-ai/minimax/hailuo-2.3/pro/image-to-video

# Google — сортировка ракурсов (photo_order)
GOOGLE_AI_API_KEY=

# DashScope — тренировки, питание, оверлей замеров
DASHSCOPE_API_KEY=
DASHSCOPE_HTTP_ORIGIN=https://dashscope-intl.aliyuncs.com
DASHSCOPE_TEXT_MODEL=qwen-plus
DASHSCOPE_QWEN_IMAGE_EDIT_MODEL=qwen-image-2.0

MUSCLE_PROMPT_SCALE=0.55
MUSCLE_PROMPT_MAX_PCT=18

# Ракурсы для «после» и Hailuo (старт анфас, финиш спина): front,back | front | front,side,back
PIPELINE_AFTER_VIEWS=front,back
# Модель с end_image_url (два кадра). Hailuo 2.3 — только один кадр.
FAL_HAILUO_DUAL_MODEL=fal-ai/minimax/hailuo-02/standard/image-to-video

# HTTPS_PROXY=http://user:pass@host:port
